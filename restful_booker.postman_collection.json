    {
      "name": "update booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let body = pm.response.json();\r",
              "\r",
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    });\r",
              "pm.test(\"Booking is updated\", function () {\r",
              "    pm.expect(body.firstname).to.eql(\"Hanako\");\r",
              "    pm.expect(body.lastname).to.eql(\"Suzuki\");\r",
              "    pm.expect(body.totalprice).to.eql(500);\r",
              "    pm.expect(body.depositpaid).to.eql(true);\r",
              "    pm.expect(body.bookingdates.checkin).to.eql(\"2026-08-28\");\r",
              "    pm.expect(body.bookingdates.checkout).to.eql(\"2026-08-30\");\r",
              "    pm.expect(body.additionalneeds).to.eql(\"Launch\")\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "accept": true
        }
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PUT",
