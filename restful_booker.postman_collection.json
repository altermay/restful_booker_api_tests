    {
      "name": "get booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let body = pm.response.json();\r",
              "\r",
              "pm.test(\"Status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "pm.test(\"Response time is less than 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "    });\r",
              "\r",
              "pm.test(\"Booking has all details\", function () {\r",
              "\r",
              "    pm.expect(body).to.have.property(\"firstname\");\r",
              "    pm.expect(body).to.have.property(\"lastname\");\r",
              "    pm.expect(body).to.have.property(\"totalprice\");\r",
              "    pm.expect(body).to.have.property(\"depositpaid\");\r",
              "    pm.expect(body).to.have.property(\"bookingdates\");\r",
              "    pm.expect(body.bookingdates).to.have.property(\"checkin\");\r",
              "    pm.expect(body.bookingdates).to.have.property(\"checkout\");\r",
              "    pm.expect(body).to.have.property(\"additionalneeds\")\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
